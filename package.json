{
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "concurrently \"npm run dev:admin\" \"npm run dev:pdf\"",
        "dev:admin": "vite --config vite.config.js",
        "dev:pdf": "vite --config vite.pdf.config.js",
        "build": "npm run build:admin && npm run build:pdf",
        "build:admin": "vite build --config vite.config.js",
        "build:pdf": "vite build --config vite.pdf.config.js",
        "clean": "powershell -Command \"Remove-Item -Recurse -Force public/build, public/pdf, public/frontend -ErrorAction SilentlyContinue\"",
        "build:tree": "node bin/build.js",
        "dev:tree": "node bin/build.js --dev",
        "watch:tree": "node bin/build.js --dev"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.9",
        "@tailwindcss/postcss": "^4.1.13",
        "@tailwindcss/typography": "^0.5.15",
        "axios": "^1.7.4",
        "concurrently": "^8.2.2",
        "esbuild": "^0.25.9",
        "laravel-vite-plugin": "^1.1.0",
        "postcss": "^8.4.49",
        "postcss-nesting": "^13.0.1",
        "tailwindcss": "^4.1.13",
        "vite": "^5.0"
    },
    "dependencies": {
        "diff2html": "^3.4.48",
        "jquery": "^3.7.1",
        "puppeteer": "^23.10.2",
        "sortablejs": "^1.15.6"
    }
}
