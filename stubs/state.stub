<?php

namespace App\Models\States\{{ model }};

use Filament\Support\Contracts\HasColor;
use Filament\Support\Contracts\HasDescription;
use Filament\Support\Contracts\HasIcon;
use Filament\Support\Contracts\HasLabel;

class {{ state }} extends {{ model }}State implements HasDescription, HasColor, HasIcon, HasLabel
{
    public static $name = '{{ state_lowercase }}';
    public $isSaveHidden = false;

    public function getLabel(): string
    {
        return __('{{ state_label }}');
    }

    public function getColor(): string
    {
        return 'gray';
    }

    public function getIcon(): string
    {
        return 'heroicon-o-pencil';
    }

    public function getDescription(): ?string
    {
        return __('{{ state_label }}');
    }
}
