<?php

namespace App\Models\States\{{ model }};

use Spatie\ModelStates\State;
use Spatie\ModelStates\StateConfig;
use A909M\FilamentStateFusion\Concerns\StateFusionInfo;
use A909M\FilamentStateFusion\Contracts\HasFilamentStateFusion;

abstract class {{ model }}State extends State implements HasFilamentStateFusion
{
    use StateFusionInfo;

    public $isSaveHidden = false;

    public static function config(): StateConfig
    {
        return parent::config()
            ->default({{ first_state_created }}::class)
            {{ transitions }};
    }
}
