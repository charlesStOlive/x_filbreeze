{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "repositories": {
        "filament-permission-manager-vcs": {
            "type": "vcs",
            "url": "https://github.com/charlesStOlive/filament-permission-manager.git"
        },
        "filament-color-installer-vcs": {
            "type": "vcs",
            "url": "https://github.com/charlesStOlive/filament-color-installer.git"
        },
        "filament-msgraph-email-vcs": {
            "type": "vcs",
            "url": "https://github.com/charlesStOlive/filament-msgraph-email.git"
        },
        "filament-state-fusion-enhanced-vcs": {
            "type": "vcs",
            "url": "https://github.com//charlesStOlive/filament-state-fusion-enhancedV2.git"
        }
    },
    "require": {
        "php": "^8.3",
        "barryvdh/laravel-snappy": "^1.0",
        "charlesstolive/filament-color-installer": "dev-main",
        "charlesstolive/filament-msgraph-email": "dev-master",
        "charlesstolive/filament-permission-manager": "@dev",
        "charlesstolive/filament-state-fusion-enhanced": "dev-master",
        "cloudinary-labs/cloudinary-laravel": "^3.0",
        "filament/filament": "~5.0",
        "filament/spatie-laravel-media-library-plugin": "~5.0",
        "gwsn/flysystem-sharepoint-adapter": "^1.1",
        "intervention/image": "*",
        "ksubileau/color-thief-php": "^2.0",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.9",
        "maartenpaauw/laravel-specification-pattern": "^3.1",
        "maatwebsite/excel": "^3.1",
        "owenvoke/blade-fontawesome": "^2.8",
        "ozdemirburak/iris": "*",
        "pboivin/filament-peek": "~4.0",
        "prism-php/prism": "^0.99.2",
        "smalot/pdfparser": "^2.11",
        "solution-forest/filament-tree": "~4.0",
        "soundasleep/html2text": "^2.1",
        "spatie/browsershot": "^5.0",
        "spatie/laravel-data": "^4.18",
        "spatie/laravel-model-states": "^2.9",
        "spatie/laravel-permission": "*",
        "spatie/laravel-settings": "^3.4",
        "thiagoalessio/tesseract_ocr": "^2.13"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.6",
        "doctrine/dbal": "^4.1",
        "fakerphp/faker": "^1.23",
        "filament/upgrade": "~5.0",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.52",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "tbachert/spi": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}